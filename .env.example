# ---------------------------------------------------------------------------
# Bharti — environment configuration
#
# Copy to .env and fill in. Only SECRET_KEY is required.
#   cp .env.example .env
#   python -c "import secrets; print('SECRET_KEY=' + secrets.token_urlsafe(48))" >> .env
# ---------------------------------------------------------------------------

# REQUIRED in production. JWT signing key. The app refuses to start in
# production without it, and docker-compose refuses to start without it at all.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production | test
# Production enables HSTS and enforces SECRET_KEY.
ENVIRONMENT=development

# Any SQLAlchemy URL.
#   SQLite (default, zero setup):  sqlite:///./bharti.db
#   Postgres:                      postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./bharti.db

# Access token lifetime in minutes. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated CORS allow-list. Set this to your real origin in production.
CORS_ORIGINS=http://localhost:8000

# Rate limits, requests per minute per IP.
# NOTE: per-process. N workers means N times these numbers. Redis is the fix.
RATE_LIMIT_AUTH=10
RATE_LIMIT_DEFAULT=120

# Whether the first registered account becomes an admin.
# Leave FALSE on any public deployment — otherwise the first stranger to find
# the signup form owns the platform.
FIRST_USER_IS_ADMIN=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
